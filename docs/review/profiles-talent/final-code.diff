+      expect(saved.presentation.stage_name).toBe("Alias revisado QA");
+      expect(saved.portfolio_items[0].kind).toBe("project");
+      await page.goto("/perfiles/" + talent);
+      await expect(
+        page.getByText("Alias revisado QA", { exact: true }),
+      ).toBeVisible();
