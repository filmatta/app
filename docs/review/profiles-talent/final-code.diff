+ .profile-catalog-tabs a { font-size:.8rem; }
+ .profile-catalog { padding-top:2.5rem; }
+ .profile-results > p:last-child { max-width:27ch; line-height:1.7; }
+ .profile-identity { padding-top:2.5rem; }
+ .profile-reel figcaption { flex-direction:column; gap:.25rem; }
+ .profile-work > a { grid-template-columns:1fr auto; }
+ .profile-work > a > .eyebrow { grid-column:1/-1; }
+ .profile-body { padding-top:2rem; }
+ .profile-save-bar { flex-wrap:wrap; bottom:.5rem; padding:.85rem; }
+ .profile-save-bar > div { width:100%; justify-content:space-between; gap:1rem; }
+ .profile-save-bar > p > span { display:inline; margin-left:.5rem; }
+ .profile-discipline-options { grid-template-columns:repeat(2,minmax(0,1fr)); }
+ .profile-discipline-options label { font-size:.75rem; padding:.7rem; }
+ .profile-edit-item { padding:1rem; }
+}
+@media(prefers-reduced-motion:reduce) { .profiles-page * { transition:none!important; animation:none!important; scroll-behavior:auto!important; } }
+
