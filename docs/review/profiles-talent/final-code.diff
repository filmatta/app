+        .getByRole("button", { name: "Guardar perfil", exact: true })
+        .click();
+      await expect(
+        editor.getByRole("status").filter({ hasText: "Perfil guardado" }),
+      ).toHaveText("Perfil guardado como borrador.");
+      expect(
+        checked(
+          await anon.rpc("get_public_professional_portfolio", {
+            p_slug: talent,
+          }),
+        ),
+      ).toEqual([]);
