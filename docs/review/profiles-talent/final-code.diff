+ .profile-filter-disclosure { margin-bottom:1.5rem; border-bottom:1px solid #ffffff25; }
+ .profile-filter-disclosure[data-expanded=false] .profile-filter-content { display:none; }
+ .profiles-page .profile-filter-disclosure .catalog-filters { margin-bottom:.5rem; }
+}
